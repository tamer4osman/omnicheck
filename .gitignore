swift-argument-parser-1.5.0/
ktor

# SPRINT-23 restore leg: `core.*` above silently untracked the Kotlin
# resolver fixture (files_analyzed 11 -> 10, test_sprint22 1 failure).
# Same landmine as the core.py exception above -- the fixture MUST be
# tracked. Caught by the 2026-11-23 slim-artifact restore on a degraded
# tree; the M1 drift-replay lesson applies to restores, not just clones.
!tests/fixtures/kotlin_resolver/core.kt

